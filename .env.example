# Names of the environment variables this repository reads. Values never go
# in git: set them in the Vercel project (Settings -> Environment Variables)
# or in an untracked env file next to this one. `pnpm check:secrets` fails if
# a value is filled in here.

# Public URL of the app. Defaults to https://lab.despell.io.
NEXT_PUBLIC_SITE_URL=

# Wallet connection (DES-697). WalletConnect / Reown project id, public by design.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Test-network RPC endpoints. Leave empty to use the public endpoints.
BASE_SEPOLIA_RPC_URL=
GIWA_SEPOLIA_RPC_URL=
REACTIVE_LASNA_RPC_URL=
XLAYER_RPC_URL=

# Router journal database, read-only role limited to pool_cards,
# pool_journal_entries and pool_blocks (xlayer/). Server only.
JOURNAL_DATABASE_URL=

# CoinMarketCap API key (cmc/). Server only.
CMC_API_KEY=
