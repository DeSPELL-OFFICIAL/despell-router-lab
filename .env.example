# Names of the environment variables this repository reads. Values never go
# in git: set them in the Vercel project (Settings -> Environment Variables)
# or in an untracked env file next to this one. `pnpm check:secrets` fails if
# a value is filled in here.

# Public URL of the app. Defaults to https://lab.despell.io.
NEXT_PUBLIC_SITE_URL=

# Wallet connection (DES-697). WalletConnect / Reown project id, public by design.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Test-network RPC endpoints. Leave empty to use the public endpoints.
BASE_SEPOLIA_RPC_URL=
GIWA_SEPOLIA_RPC_URL=
REACTIVE_LASNA_RPC_URL=
XLAYER_RPC_URL=

# Another tape-out of the pool judgment circuit on X Layer, overriding the one
# written in the app (DES-699, circuit #1). Public values; both or neither.
# Unset or malformed: the app uses its own.
NEXT_PUBLIC_XLAYER_PROCESSOR=
NEXT_PUBLIC_XLAYER_CIRCUIT_ID=

# CoinMarketCap Pro API key (cmc/), sent as the X-CMC_PRO_API_KEY header. Server only.
CMC_PRO_API_KEY=

# LI.FI API key for route quotes (cmc/), optional: without it the public quote
# limit is a few dozen an hour. Sent as the x-lifi-api-key header. Server only.
LIFI_API_KEY=

# DeSpell connector that prepares buy links (/cmc). Defaults to the production
# app, https://app.despell.io/api/mcp; https://test.despell.io/api/mcp is the
# test deployment.
DESPELL_MCP_URL=
